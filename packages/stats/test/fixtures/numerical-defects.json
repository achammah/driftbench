  "provenance": {
    "script": "packages/validators/fixtures/stats/make_exact_defects.py",
    "numpy": "2.5.2",
    "sources": {
      "hillNumber.large-q": "80-digit decimals: (sum p^q)^(1 / (1 - q))",
      "zFor.tiny-alpha": "scipy.stats.norm.isf(alpha / 2)",
      "wilsonEffective.tiny-alpha": "wilson_effective_ref with the normal quantile from scipy.stats.norm.isf",
      "pairedRateDifference.tiny-alpha": "Newcombe's method 10 restated with scipy.stats.norm.isf",
      "clopperPearson.tiny-alpha": "scipy.stats.beta.ppf and isf (the Clopper-Pearson limits)",
      "mde.tiny-alpha": "mde_ref with the two-sided z from scipy.stats.norm.isf",
      "normalQuantile.subnormal-p": "scipy.stats.norm.ppf",
      "betaQuantile.far-tail": "scipy.special.betaincinv in the region where the quantile is below 1e-60",
      "incompleteBeta.large-shape": "scipy.special.betainc, shapes from 1e4 to 3e6 near the mean",
      "chiSquareSf.large-df": "scipy.stats.chi2.sf, df from 1e5 to 3e6 around the mean",
      "binomialCdf.large-n": "scipy.stats.binom.cdf, n from 1e6 to 3e7",
      "binomialCdf.huge-n-time": "scipy.stats.binom.cdf at n = 1e9 and 2e9 (the answer must come in a few seconds, not after a loop over k)",
      "ksTest.separated-samples": "separated samples: D = 1 and p = 2 / C(m + n, m), in exact rational arithmetic",
      "ksTest.tail-lattice": "the number of lattice paths inside the band, by dynamic programming in exact rationals (Hodges 1957)"
    }
  },
