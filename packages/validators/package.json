{
  "name": "@agent-nexus/driftbench-validators",
  "version": "0.1.0",
  "description": "Validators that prove driftbench works: each plants a known truth, runs one part of the framework and scores a ladder of levels.",
  "keywords": [
    "driftbench",
    "ai-agents",
    "evaluation",
    "llm",
    "testing",
    "validation",
    "planted-truth",
    "meta-evaluation"
  ],
  "homepage": "https://github.com/achammah/driftbench#readme",
  "bugs": {
    "url": "https://github.com/achammah/driftbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achammah/driftbench.git",
    "directory": "packages/validators"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:runtime && tsup src/index.ts --format esm --dts-only --target node22",
    "build:runtime": "tsup src/index.ts --format esm --clean --target node22 && tsup src/ladders/stats/bank/child.ts --format esm --target node22 --out-dir dist/stats-bank"
  },
  "dependencies": {
    "@agent-nexus/driftbench-core": "workspace:*",
    "@agent-nexus/driftbench-stats": "workspace:*",
    "@agent-nexus/driftbench-checks": "workspace:*",
    "@agent-nexus/driftbench-adapters": "workspace:*",
    "@agent-nexus/driftbench-generate": "workspace:*",
    "@agent-nexus/driftbench-judges": "workspace:*",
    "@agent-nexus/driftbench-estate": "workspace:*",
    "@agent-nexus/driftbench-space": "workspace:*",
    "@agent-nexus/driftbench-store": "workspace:*",
    "@agent-nexus/driftbench-users": "workspace:*",
    "@agent-nexus/driftbench-sandbox": "workspace:*",
    "@agent-nexus/driftbench-artifacts": "workspace:*",
    "zod": "^4.6.5",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
