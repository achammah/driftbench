{
  "provenance": {
    "script": "packages/validators/fixtures/stats/make_exact_capabilities.py",
    "numpy": "2.5.2",
    "sources": {
      "holm.textbook": "Holm 1979: adjusted = running maximum of min(1, (m - j + 1) p(j)) over the sorted p-values",
      "holm.order": "the adjusted values come back in the input order, not the sorted order",
      "holm.ties": "tied p-values get the same adjusted value",
      "holm.monotone": "the running maximum keeps the adjusted values non-decreasing in rank",
      "holm.cap-at-one": "an adjusted value above 1 is 1",
      "holm.alpha": "alpha 0.01, 0.05, 0.2 and the boundary p(j) (m - j + 1) = alpha is rejected",
      "holm.single-and-empty": "one hypothesis is its own p-value; none gives empty lists",
      "holm.stricter-than-bh": "Holm never rejects more than Benjamini-Hochberg (scipy.stats.false_discovery_control gives the BH adjusted values to compare with)",
      "sampleSizeForEffect.defaults": "the two-proportion power equation solved for n (scipy.stats.norm), defaults power 0.8 alpha 0.05",
      "sampleSizeForEffect.power": "power 0.5, 0.9, 0.95",
      "sampleSizeForEffect.alpha": "alpha 0.2, 0.01, 0.001",
      "sampleSizeForEffect.repeats": "repeats without correlation: n shrinks in proportion",
      "sampleSizeForEffect.rho": "repeats with a correlation: the design effect 1 + (repeats - 1) rho",
      "sampleSizeForEffect.whole-number": "n is a whole number, the smallest whose effective units reach the need",
      "sampleSizeForEffect.small-effect": "a small effect needs many specs",
      "sampleSizeForEffect.inverse-of-mde": "mde(n) at the returned n is at most the effect, and at n - 1 it is above it",
      "kappaInterval.binary": "kappa and its large-sample interval from the 2 x 2 table, exact rationals for po and pe",
      "kappaInterval.multi-class": "three to five categories",
      "kappaInterval.alpha": "alpha 0.2, 0.1, 0.01",
      "kappaInterval.perfect": "perfect agreement with more than one category: kappa 1, se 0",
      "kappaInterval.chance-level": "agreement at chance: kappa near 0",
      "kappaInterval.constant-raters": "both raters give one label throughout: pe = 1, the interval is the point",
      "kappaInterval.clipped": "the interval is clipped to [-1, 1]",
      "kappaInterval.disagreement": "systematic disagreement gives a negative kappa",
      "kappaInterval.labels": "labels may be strings or booleans",
      "mcnemarMidP.small": "exact rationals: 2 P(X < k) + P(X = k), X binomial(b + c, 0.5)",
      "mcnemarMidP.symmetric": "the test does not care which side is larger",
      "mcnemarMidP.no-discordant": "no discordant pair: p = 1",
      "mcnemarMidP.tied-sides": "b = c: the mid-p is capped at 1",
      "mcnemarMidP.larger": "tens of discordant pairs",
      "mcnemarMidP.large-count": "hundreds of discordant pairs: exact big-integer arithmetic keeps the value",
      "mcnemarMidP.less-conservative": "the mid-p is below the exact two-sided p (scipy.stats.binomtest) whenever b != c"
    }
  },
