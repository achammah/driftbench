{
  "model": "opus",
  "permissions": {
    "defaultMode": "default",
    "allow": ["Read", "Grep", "Glob", "Bash(git status)", "Bash(python3 tools/*)"],
    "deny": ["Bash(git push --force:*)", "Bash(rm -rf:*)", "WebFetch"],
    "ask": ["Bash(git commit:*)"]
  },
  "env": {
    "NORTHWIND_REGION": "eu-west",
    "NORTHWIND_LEDGER_DIR": "ledger"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/guards/block-force-push.sh" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/guards/read-before-edit.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 .claude/guards/ledger-guard.py" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/guards/stop-word.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/guards/reply-length.py" }
        ]
      }
    ]
  }
}
